# ---------- Firebase (web) ----------
# Firebase → Configuración del proyecto → Tus apps → App web.
# Sin estas variables la tienda arranca en MODO DEMO (todo en el navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correos de administración, separados por coma (deben coincidir con firestore.rules)
VITE_ADMIN_EMAILS=

# Dirección pública del sitio, sin "/" final (para enlaces de Mercado Pago y SEO)
VITE_SITE_URL=https://printly.mx

# ---------- Mercado Pago (solo en Netlify, NUNCA con prefijo VITE_) ----------
# Mercado Pago Developers → Tus integraciones → Credenciales de producción
MP_ACCESS_TOKEN=
# Webhooks → clave secreta (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# ---------- Firebase Admin (solo en Netlify) ----------
# Firebase → Configuración → Cuentas de servicio → Generar nueva clave privada.
# Pega el JSON completo convertido a base64 (ver README).
FIREBASE_SERVICE_ACCOUNT_BASE64=
